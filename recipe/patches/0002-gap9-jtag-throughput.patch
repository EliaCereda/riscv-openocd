index 487ed50e9..c6e566cf9 100644
--- a/src/target/riscv/riscv-013.c
+++ b/src/target/riscv/riscv-013.c
@@ -2595,6 +2595,179 @@ static int batch_run(const struct target *target, struct riscv_batch *batch)
 	return riscv_batch_run(batch);
 }
 
+/* System bus reads and writes (sbversion 1) are queued in batches of up to
+ * this many sbdata0 accesses, each batch one JTAG queue flush. */
+#define SB_BATCH_WORDS 1023
+
+/* Queue the sbaddress writes of sb_write_address() in a batch. */
+static void sb_batch_add_address(struct target *target, struct riscv_batch *batch,
+		target_addr_t address)
+{
+	RISCV013_INFO(info);
+	unsigned sbasize = get_field(info->sbcs, DMI_SBCS_SBASIZE);
+	if (sbasize > 96)
+		riscv_batch_add_dmi_write(batch, DMI_SBADDRESS3, 0);
+	if (sbasize > 64)
+		riscv_batch_add_dmi_write(batch, DMI_SBADDRESS2, 0);
+	if (sbasize > 32)
+#if BUILD_TARGET64
+		riscv_batch_add_dmi_write(batch, DMI_SBADDRESS1, address >> 32);
+#else
+		riscv_batch_add_dmi_write(batch, DMI_SBADDRESS1, 0);
+#endif
+	riscv_batch_add_dmi_write(batch, DMI_SBADDRESS0, address);
+}
+
+/* After a batch hit DMI busy: clear it, wait for the system bus to go idle,
+ * and clear an sbbusyerror (reported in *sbbusyerror). A bus error fails. */
+static int sb_batch_recover(struct target *target, bool *sbbusyerror)
+{
+	increase_dmi_busy_delay(target);	/* also dmireset */
+	uint32_t sbcs;
+	if (read_sbcs_nonbusy(target, &sbcs) != ERROR_OK)
+		return ERROR_FAIL;
+	if (get_field(sbcs, DMI_SBCS_SBERROR)) {
+		dmi_write(target, DMI_SBCS, DMI_SBCS_SBERROR);
+		return ERROR_FAIL;
+	}
+	*sbbusyerror = get_field(sbcs, DMI_SBCS_SBBUSYERROR);
+	if (*sbbusyerror && dmi_write(target, DMI_SBCS, DMI_SBCS_SBBUSYERROR) != ERROR_OK)
+		return ERROR_FAIL;
+	return ERROR_OK;
+}
+
+/**
+ * Read memory over the system bus in batches, for accesses of at most 4 bytes
+ * (one sbdata0 read per element).
+ *
+ * With sbreadondata set, each read of sbdata0 returns one element and starts
+ * the bus read of the next, so a batch reads up to SB_BATCH_WORDS elements in
+ * one JTAG flush. The first batch also writes sbcs and sbaddress, and each
+ * batch ends with a read of sbcs. The last element is read in a batch of its
+ * own, after sbreadondata is cleared, so no bus read goes past the end; the
+ * debugger may write sbcs only once sbbusy is seen low, which the previous
+ * batch's sbcs read shows. A read of a single element is one batch.
+ *
+ * A DMI busy anywhere in a batch drops the rest of it: the batch restarts at
+ * the first lost element with more idle cycles. An sbbusyerror (an sbdata0
+ * read overtook a bus read) restarts the whole batch with a longer bus read
+ * delay.
+ */
+static int read_memory_bus_v1_batched(struct target *target, target_addr_t address,
+		uint32_t size, uint32_t count, uint8_t *buffer)
+{
+	RISCV013_INFO(info);
+	uint32_t sbcs_write = set_field(0, DMI_SBCS_SBREADONADDR, 1);
+	sbcs_write |= sb_sbaccess(size);
+	sbcs_write = set_field(sbcs_write, DMI_SBCS_SBAUTOINCREMENT, 1);
+
+	uint32_t next = 0;	/* the first element the next batch reads */
+	bool setup = true;	/* the next batch must write sbcs and sbaddress first */
+	bool sbbusy = false;	/* the last sbcs read saw sbbusy */
+	time_t start = time(NULL);
+
+	while (next < count) {
+		if (time(NULL) - start > riscv_command_timeout_sec) {
+			LOG_ERROR("No progress for %ds reading memory over the system bus. "
+					"Increase the timeout with riscv set_command_timeout_sec.",
+					riscv_command_timeout_sec);
+			return ERROR_FAIL;
+		}
+
+		bool last = next == count - 1;
+		if (last && !setup && sbbusy) {
+			/* sbcs may be written only once sbbusy is low. */
+			uint32_t sbcs;
+			if (read_sbcs_nonbusy(target, &sbcs) != ERROR_OK)
+				return ERROR_FAIL;
+			if (get_field(sbcs, DMI_SBCS_SBERROR)) {
+				dmi_write(target, DMI_SBCS, DMI_SBCS_SBERROR);
+				return ERROR_FAIL;
+			}
+		}
+
+		struct riscv_batch *batch = riscv_batch_alloc(target, SB_BATCH_WORDS + 8,
+				info->dmi_busy_delay + info->bus_master_read_delay);
+		if (setup || last)
+			riscv_batch_add_dmi_write(batch, DMI_SBCS,
+					set_field(sbcs_write, DMI_SBCS_SBREADONDATA, !last));
+		if (setup)	/* This address write starts the bus read of element next. */
+			sb_batch_add_address(target, batch, address + next * size);
+		uint32_t n = last ? 1 : MIN(SB_BATCH_WORDS, count - 1 - next);
+		size_t first_key = riscv_batch_add_dmi_read(batch, DMI_SBDATA0);
+		for (uint32_t i = 1; i < n; i++)
+			riscv_batch_add_dmi_read(batch, DMI_SBDATA0);
+		size_t sbcs_key = riscv_batch_add_dmi_read(batch, DMI_SBCS);
+
+		if (batch_run(target, batch) != ERROR_OK) {
+			riscv_batch_free(batch);
+			return ERROR_FAIL;
+		}
+
+		/* The elements read before a DMI busy, if any. */
+		uint32_t ok = 0;
+		dmi_status_t status = DMI_STATUS_SUCCESS;
+		for (; ok <= n; ok++) {
+			status = get_field(riscv_batch_get_dmi_read(batch, ok < n ? first_key + ok : sbcs_key),
+					DTM_DMI_OP);
+			if (status != DMI_STATUS_SUCCESS)
+				break;
+		}
+		if (status == DMI_STATUS_FAILED) {
+			LOG_ERROR("Failed system bus read at 0x%" TARGET_PRIxADDR, address + (next + ok) * size);
+			riscv_batch_free(batch);
+			return ERROR_FAIL;
+		}
+
+		bool sbbusyerror;
+		if (status == DMI_STATUS_BUSY) {
+			if (sb_batch_recover(target, &sbbusyerror) != ERROR_OK) {
+				riscv_batch_free(batch);
+				return ERROR_FAIL;
+			}
+			LOG_INFO("System bus read: DMI busy at element %u of %u, retrying with %d idle cycles",
+					MIN(ok, n), n, info->dmi_busy_delay);
+		} else {
+			uint32_t sbcs = get_field(riscv_batch_get_dmi_read(batch, sbcs_key), DTM_DMI_DATA);
+			if (get_field(sbcs, DMI_SBCS_SBERROR)) {
+				riscv_batch_free(batch);
+				dmi_write(target, DMI_SBCS, DMI_SBCS_SBERROR);
+				return ERROR_FAIL;
+			}
+			sbbusyerror = get_field(sbcs, DMI_SBCS_SBBUSYERROR);
+			if (sbbusyerror) {
+				uint32_t idle;
+				if (dmi_write(target, DMI_SBCS, DMI_SBCS_SBBUSYERROR) != ERROR_OK ||
+						read_sbcs_nonbusy(target, &idle) != ERROR_OK) {
+					riscv_batch_free(batch);
+					return ERROR_FAIL;
+				}
+			}
+			sbbusy = get_field(sbcs, DMI_SBCS_SBBUSY);
+		}
+
+		if (sbbusyerror) {
+			/* An sbdata0 read overtook a bus read: any element may be stale. */
+			info->bus_master_read_delay += info->bus_master_read_delay / 10 + 1;
+			LOG_INFO("System bus read: sbbusyerror, retrying with a bus read delay of %d",
+					info->bus_master_read_delay);
+			ok = 0;
+		}
+		for (uint32_t i = 0; i < MIN(ok, n); i++) {
+			uint32_t value = get_field(riscv_batch_get_dmi_read(batch, first_key + i), DTM_DMI_DATA);
+			write_to_buf(buffer + (next + i) * size, value, size);
+			log_memory_access(address + (next + i) * size, value, size, true);
+		}
+		riscv_batch_free(batch);
+		next += MIN(ok, n);
+		if (ok > 0)
+			start = time(NULL);
+		/* After a DMI busy or an sbbusyerror the bus address is unknown. */
+		setup = status != DMI_STATUS_SUCCESS || sbbusyerror;
+	}
+	return ERROR_OK;
+}
