+/**
+ * Read a NUL-terminated string from the target, for SYS_WRITE0: its length
+ * goes to *len and, with print, its characters to stdout. It is read in
+ * aligned 64-byte chunks of 32-bit words rather than one byte per access,
+ * which on a target whose system bus has no byte access (GAP9) costs a
+ * program-buffer round trip per byte. A chunk whose word read fails is read
+ * byte by byte.
+ */
+static int semihosting_read_string(struct target *target, uint64_t addr,
+	bool print, size_t *len)
+{
+	*len = 0;
+	for (;;) {
+		uint64_t chunk = addr & ~(uint64_t)63;
+		unsigned from = addr - chunk;
+		uint8_t buf[64];
+		if (target_read_memory(target, chunk, 4, 16, buf) != ERROR_OK) {
+			for (unsigned i = from; i < 64; i++) {
+				int retval = target_read_memory(target, chunk + i, 1, 1, buf + i);
+				if (retval != ERROR_OK)
+					return retval;
+				if (!buf[i])
+					break;
+			}
+		}
+		for (unsigned i = from; i < 64; i++) {
+			if (!buf[i])
+				return ERROR_OK;
+			if (print)
+				putchar(buf[i]);
+			(*len)++;
+		}
+		addr = chunk + 64;
+	}
+}
