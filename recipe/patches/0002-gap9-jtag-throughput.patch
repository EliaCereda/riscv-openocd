+COMMAND_HANDLER(handle_target_poll_interval_command)
+{
+	if (CMD_ARGC > 1)
+		return ERROR_COMMAND_SYNTAX_ERROR;
+	if (CMD_ARGC == 1) {
+		int ms;
+		COMMAND_PARSE_NUMBER(int, CMD_ARGV[0], ms);
+		if (ms < 1) {
+			LOG_ERROR("target_poll_interval: the interval must be at least 1 ms");
+			return ERROR_COMMAND_ARGUMENT_INVALID;
+		}
+		polling_interval = ms;
+		/* After init the poll timer is running: move it to the new interval. */
+		for (struct target_timer_callback *c = target_timer_callbacks; c; c = c->next) {
+			if (c->callback == handle_target && !c->removed) {
+				c->time_ms = ms;
+				gettimeofday(&c->when, NULL);
+				timeval_add_time(&c->when, 0, ms * 1000);
+			}
+		}
+	}
+	command_print(CMD, "target poll interval: %d ms", polling_interval);
+	return ERROR_OK;
